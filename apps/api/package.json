{
  "name": "@dtd/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,worker -c green,magenta \"nodemon\" \"nodemon --config nodemon.worker.json\"",
    "build": "rolldown -c rolldown.config.mjs",
    "start": "node --enable-source-maps dist/main.js",
    "start:worker": "node --enable-source-maps dist/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "admin:create": "node --env-file-if-exists=../../.env --import @swc-node/register/esm-register scripts/admin-create.ts",
    "postinstall": "prisma generate",
    "sources": "node --env-file-if-exists=../../.env --import @swc-node/register/esm-register scripts/sources.ts",
    "world": "node --env-file-if-exists=../../.env --import @swc-node/register/esm-register scripts/world.ts",
    "assets-import": "node --env-file-if-exists=../../.env --import @swc-node/register/esm-register scripts/assets-import.ts",
    "scenes-seed": "node --env-file-if-exists=../../.env --import @swc-node/register/esm-register scripts/scenes-seed.ts",
    "guide:eval": "node --import @swc-node/register/esm-register scripts/guide-eval.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "@dtd/contracts": "workspace:*",
    "@dtd/scene-runtime": "workspace:*",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@nestjs/common": "^12.1.0",
    "@nestjs/core": "^12.1.0",
    "@nestjs/platform-express": "^12.1.0",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "cookie-parser": "^1.4.7",
    "meshoptimizer": "^0.22.0",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@dtd/config": "workspace:*",
    "@nestjs/testing": "^12.1.0",
    "@swc-node/register": "^1.10.10",
    "@swc/core": "^1.16.2",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.2.0",
    "dotenv": "^17.0.0",
    "nodemon": "^3.1.10",
    "prisma": "7.10.0",
    "rolldown": "1.2.11",
    "supertest": "^7.1.4",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.2"
  }
}
