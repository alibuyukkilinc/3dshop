{
  "name": "@dtd/engine-lab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Motor prototipi (K20): aynı dtd.scene.v1 sahnesini Babylon.js ve Three.js ile çizip ölçer. Atılabilir kod; karar sonrası seçilen adaptör packages/engine-* altına taşınır.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/bundle-size.mjs",
    "typecheck": "tsc --noEmit",
    "measure": "node scripts/measure.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "9.31.3",
    "@dtd/scene-runtime": "workspace:*",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@dtd/config": "workspace:*",
    "@types/three": "0.186.0",
    "vite": "^8.3.1",
    "@playwright/test": "1.63.0"
  }
}