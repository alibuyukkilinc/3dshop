# Kopyala: .env  (asla repoya girmez). Yerel geliştirme veritabanı: dtd_dev (PostgreSQL 17)
# Roller ve .env, `pnpm db:init` (scripts/db/init-dev.ps1) ile oluşturulur.

NODE_ENV=development
# Finans yerelde 3000 kullanır; çakışmasın diye 3100
API_PORT=3100

# Çalışma anı rolü (tablo sahibi değil; audit_log üzerinde UPDATE/DELETE yetkisi yok)
DATABASE_URL=postgresql://dtd_app:DEGISTIR@localhost:5432/dtd_dev
# Göç: tablo sahibi rol (CREATEDB: testler geçici veritabanı açar)
DATABASE_MIGRATION_URL=postgresql://dtd_owner:DEGISTIR@localhost:5432/dtd_dev

# Tarayıcı adresleri (CSRF Origin kontrolü), virgülle ayrılmış
APP_ORIGINS=http://localhost:5174,http://localhost:3101
COOKIE_SECURE=false
ADMIN_SESSION_TTL_HOURS=12

# Veritabanındaki gizli değerleri (TOTP sırları, adaptör anahtarları) şifreleyen 32 baytlık anahtar (base64).
# Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_KEY=DEGISTIR

# TOTP uygulamasında görünen ad
TOTP_ISSUER=firmaxi

# AI rehber (F5.2, K52). Boşsa rehber kapalı; anahtarı yalnız sunucu .env dosyasına girin.
ANTHROPIC_API_KEY=
AI_GUIDE_MODEL=claude-opus-5-5
AI_GUIDE_DAILY_MAX=2000
